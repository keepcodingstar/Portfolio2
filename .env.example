# Shared fragrance likes and private visitor feedback on Vercel or another serverless host.
# These are server-only values. Never prefix them with NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local development automatically uses .data/fragrance-likes.sqlite (Node 22.13+).
# Self-hosted production may instead use an absolute path on a persistent disk:
# FRAGRANCE_LIKES_DB_PATH=/persistent-data/fragrance-likes.sqlite

# Visitor feedback uses the same Redis connection; no extra setup on Vercel.
# Local development automatically uses .data/feedback.sqlite.
# FEEDBACK_DB_PATH=/persistent-data/feedback.sqlite
